@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100 bg-black text-white">
    <!-- Navbar Oficial -->
    <NavMenu />

    <!-- Contenido Dinámico Principal -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Botón Flotante de WhatsApp para Soporte -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
        <a href="https://wa.me/573006904099"
           target="_blank" 
           rel="noopener noreferrer" 
           class="btn btn-success rounded-circle shadow-lg d-flex align-items-center justify-content-center" 
           style="width: 56px; height: 56px; background-color: #25D366; border: 2px solid #D4AF37; box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);" 
           aria-label="Consultar eventos y entradas por WhatsApp">
            <i class="bi bi-whatsapp fs-3 text-white"></i>
        </a>
    </div>

    <footer class="site-footer">
        <div class="container">
            <a class="footer-brand" href="/">
                <img src="images/ugp/logo.png" alt="Último Guerrero en Pie — Inicio" />
            </a>
            <nav class="footer-links" aria-label="Boletos y eventos">
                <a href="/#eventos">Eventos</a>
                <a href="/peleadores">Peleadores</a>
                <a href="/contacto">Contacto</a>
                <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
                <a href="/#experiencias">Experiencias</a>
                <a href="/#patrocinadores">Patrocinadores</a>
                <a href="/checkout/confirmacion">Mis boletos</a>
                <a href="/#validar-boleto">Validar boleto</a>
            </nav>
            <nav class="footer-links footer-social" aria-label="Redes sociales">
                <a href="https://www.facebook.com/ultimoguerreroenpie">Facebook</a>
                <a href="https://www.instagram.com/ultimoguerreroenpie">Instagram</a>
                <a href="https://www.tiktok.com/@@ultimoguerreroenpie">TikTok</a>
                <a href="https://www.youtube.com/@@UGP-%C3%9AltimoGuerreroenPie-u2k">YouTube</a>
                <a href="https://wa.me/573006904099">WhatsApp</a>
            </nav>
            <p class="footer-copyright">© @DateTime.UtcNow.Year Último Guerrero en Pie</p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Se ha producido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
