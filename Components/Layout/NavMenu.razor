@rendermode InteractiveServer

<header class="site-header">
    <nav class="navbar navbar-expand-lg container" aria-label="Navegación principal">
        <a class="navbar-brand" href="/" @onclick="CloseMenu">
            <img src="images/ugp/logo.png" alt="Último Guerrero en Pie — Inicio" />
        </a>

        <button type="button" class="navbar-toggler site-menu-toggle" aria-controls="ugp-menu"
                aria-expanded="@(menuOpen ? "true" : "false")" @onclick="ToggleMenu">
            <i class="bi @(menuOpen ? "bi-x-lg" : "bi-list")" aria-hidden="true"></i>
            Menú
        </button>

        <div id="ugp-menu" class="collapse navbar-collapse @(menuOpen ? "show" : null)">
            <ul class="navbar-nav ms-lg-auto align-items-lg-center">
                <li><NavLink class="site-link" href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">Inicio</NavLink></li>
                <li><a class="site-link" href="/#eventos" @onclick="CloseMenu">Eventos</a></li>
                <li><NavLink class="site-link" href="/peleadores" @onclick="CloseMenu">Peleadores</NavLink></li>
                <li><NavLink class="site-link" href="/contacto" @onclick="CloseMenu">Contacto</NavLink></li>
                <li><NavLink class="site-link" href="/preguntas-frecuentes" @onclick="CloseMenu">Preguntas frecuentes</NavLink></li>
                <li><a class="site-link" href="/checkout/confirmacion" @onclick="CloseMenu">Mis boletos</a></li>
                <li><a class="site-link" href="/#validar-boleto" @onclick="CloseMenu">Validar boleto</a></li>
                <li><a class="site-link site-cta" href="/#eventos" @onclick="CloseMenu">Ver entradas</a></li>
            </ul>
        </div>
    </nav>
</header>

@code {
    private bool menuOpen;

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
}
