@page "/checkout"
@page "/checkout/{EventoId:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject ICompraService CompraService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationState
@inject UGP_ultimo_guerrero_en_pie_.Services.Implementations.CompraAccess AccesoCompra
@inject IJSRuntime JS

<PageTitle>Comprar Boletos | UGP - Ultimate Grappling Promotion</PageTitle>

<div class="py-5" style="background: radial-gradient(circle at 50% 10%, rgba(212,175,55,0.06) 0%, rgba(11,11,11,1) 80%); min-height: 85vh;">
    <div class="container py-4">

        @if (Cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Cargando evento...</span>
                </div>
                <p class="text-secondary mt-3 font-monospace">Preparando la arena de combate...</p>
            </div>
        }
        else if (EventoSeleccionado == null)
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar2-x display-1 text-secondary"></i>
                <h2 class="text-white fw-bold mt-3">Evento no encontrado</h2>
                <p class="text-secondary">@(string.IsNullOrEmpty(MensajeError) ? "No se encontró el evento solicitado o la boletería se encuentra cerrada." : MensajeError)</p>
                <a href="" class="btn-ugp-gold mt-3">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la Cartelera
                </a>
            </div>
        }
        else
        {
            <CascadingValue Value="ContextoFormulario" IsFixed="true">
            <!-- Cabecera del Evento -->
            <div class="border-bottom border-secondary pb-4 mb-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-8">
                        <span class="ugp-badge-gold mb-2">BOLETERÍA OFICIAL UGP</span>
                        <h1 class="text-white fw-bold display-6 mb-1">@EventoSeleccionado.Nombre</h1>
                        <div class="d-flex flex-wrap gap-3 text-secondary small">
                            <span><i class="bi bi-calendar-event text-warning me-1"></i> @EventoSeleccionado.Fecha.ToString("dd MMMM, yyyy")</span>
                            <span><i class="bi bi-clock text-warning me-1"></i> @EventoSeleccionado.Hora.ToString("hh:mm tt")</span>
                            <span><i class="bi bi-geo-alt text-danger me-1"></i> @EventoSeleccionado.Lugar</span>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <span class="badge bg-black border border-warning text-warning px-3 py-2 fs-6 font-monospace">
                            <i class="bi bi-ticket-fill me-1"></i> @(EventoSeleccionado.TicketsDisponibles) Boletos Disponibles
                        </span>
                    </div>
                </div>
            </div>

            <!-- Stepper Visual Deportivo -->
            <div class="row justify-content-center mb-5">
                <div class="col-lg-10">
                    <div class="d-flex justify-content-between position-relative">
                        <!-- Línea conectora de fondo -->
                        <div class="position-absolute top-50 start-0 end-0 translate-middle-y bg-secondary bg-opacity-50" style="height: 3px; z-index: 1;"></div>

                        <!-- Paso 1 -->
                        <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold @(PasoActual >= 1 ? "bg-warning text-black shadow" : "bg-dark text-white border border-secondary")" style="width: 44px; height: 44px;">
                                1
                            </div>
                            <span class="small font-monospace mt-2 @(PasoActual >= 1 ? "text-warning fw-bold" : "text-secondary")">Localidad</span>
                        </div>

                        <!-- Paso 2 -->
                        <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold @(PasoActual >= 2 ? "bg-warning text-black shadow" : "bg-dark text-white border border-secondary")" style="width: 44px; height: 44px;">
                                2
                            </div>
                            <span class="small font-monospace mt-2 @(PasoActual >= 2 ? "text-warning fw-bold" : "text-secondary")">Asistentes</span>
                        </div>

                        <!-- Paso 3 -->
                        <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold @(PasoActual >= 3 ? "bg-warning text-black shadow" : "bg-dark text-white border border-secondary")" style="width: 44px; height: 44px;">
                                3
                            </div>
                            <span class="small font-monospace mt-2 @(PasoActual >= 3 ? "text-warning fw-bold" : "text-secondary")">Pago Wompi</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mensajes de Error Globales -->
            @if (!string.IsNullOrEmpty(MensajeError))
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-white d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                    <div>@MensajeError</div>
                </div>
            }

            <!-- ==========================================================
                 PASO 1: SELECCIÓN DE LOCALIDAD Y CANTIDAD
                 ========================================================== -->
            @if (PasoActual == 1)
            {
                <div class="row g-4">
                    <div class="col-lg-8">
                        <h4 class="text-white fw-bold mb-3 font-monospace">SELECCIONA TU LOCALIDAD</h4>
                        <div class="d-flex flex-column gap-3">
                            @foreach (var tipo in TiposEntradaDisponibles)
                            {
                                <div class="card p-3 bg-dark border @(Formulario.TipoEntradaId == tipo.TipoEntradaId ? "border-warning shadow" : "border-secondary border-opacity-50")" 
                                     style="cursor: pointer; transition: all 0.2s ease; background-color: #141414 !important;" 
                                     @onclick="() => SeleccionarTipoEntrada(tipo.TipoEntradaId)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <input class="form-check-input" 
                                                   type="radio" 
                                                   name="tipoEntradaRadio" 
                                                   checked="@(Formulario.TipoEntradaId == tipo.TipoEntradaId)" />
                                            <div>
                                                <h5 class="text-white fw-bold mb-0">@tipo.Nombre</h5>
                                                <span class="text-secondary small">Aforo total: @tipo.Capacidad boletos</span>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="text-warning fs-4 fw-bold font-monospace">$@tipo.Precio.ToString("N0") <span class="small text-secondary" style="font-size:0.75rem;">COP</span></div>
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success small">Disponible</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Resumen Lateral y Selector de Cantidad -->
                    <div class="col-lg-4">
                        <div class="ugp-card p-4 border-warning border-opacity-25 sticky-top" style="top: 90px;">
                            <h5 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">RESUMEN DE BOLETOS</h5>

                            <div class="mb-3">
                                <label class="text-secondary small font-monospace mb-1">LOCALIDAD SELECCIONADA</label>
                                <div class="text-white fw-bold fs-5">@(TipoEntradaSeleccionado?.Nombre ?? "Ninguna seleccionada")</div>
                            </div>

                            <div class="mb-3">
                                <label class="text-secondary small font-monospace mb-2">CANTIDAD DE ENTRADAS</label>
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-outline-secondary text-white px-3" 
                                            @onclick="DisminuirCantidad" 
                                            disabled="@(Formulario.Cantidad <= 1)">-</button>
                                    <span class="text-white font-monospace fs-4 fw-bold px-3">@Formulario.Cantidad</span>
                                    <button class="btn btn-outline-secondary text-white px-3" 
                                            @onclick="IncrementarCantidad" 
                                            disabled="@(Formulario.Cantidad >= LimiteCantidad)">+</button>
                                </div>
                                <span class="text-muted small" style="font-size: 0.75rem;">Máximo 10 boletos por transacción.</span>
                            </div>

                            <div class="border-top border-secondary pt-3 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-secondary">Precio unitario:</span>
                                    <span class="text-white font-monospace">$@((TipoEntradaSeleccionado?.Precio ?? 0).ToString("N0"))</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center fs-5 fw-bold text-white pt-2 border-top border-secondary border-opacity-50">
                                    <span>Total:</span>
                                    <span class="text-warning font-monospace">$@SubtotalCalculado.ToString("N0") COP</span>
                                </div>
                            </div>

                            <ValidationMessage For="@(() => Formulario.EventoId)" />
                            <ValidationMessage For="@(() => Formulario.TipoEntradaId)" />
                            <ValidationMessage For="@(() => Formulario.Cantidad)" />
                            <button class="btn-ugp-gold w-100 py-3 mt-4" @onclick="AvanzarPaso2" disabled="@(LimiteCantidad < 1)">
                                <span>CONTINUAR A DATOS</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- ==========================================================
                 PASO 2: DATOS DEL COMPRADOR Y ASISTENTES
                 ========================================================== -->
            @if (PasoActual == 2)
            {
                <div class="row g-4">
                    <div class="col-lg-8">
                        <!-- Datos del Comprador -->
                        <div class="ugp-card p-4 mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="text-white fw-bold mb-0 font-monospace">DATOS DEL COMPRADOR</h4>
                                <span class="badge bg-warning text-dark font-monospace">Titular de Compra</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-secondary small">Nombre Completo *</label>
                                    <input type="text" class="form-control bg-black text-white border-secondary" @bind="Formulario.NombreComprador" placeholder="Ej: Carlos Silva" />
                                    <ValidationMessage For="@(() => Formulario.NombreComprador)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary small">Documento de Identidad *</label>
                                    <div class="input-group">
                                        <select class="form-select bg-black text-white border-secondary" style="max-width: 90px;" @bind="Formulario.TipoDocumento">
                                            <option value="CC">CC</option>
                                            <option value="CE">CE</option>
                                            <option value="TI">TI</option>
                                            <option value="PAS">PAS</option>
                                            <option value="NIT">NIT</option>
                                        </select>
                                        <input type="text" class="form-control bg-black text-white border-secondary" @bind="Formulario.DocumentoComprador" placeholder="Número de documento *" />
                                    </div>
                                    <ValidationMessage For="@(() => Formulario.TipoDocumento)" />
                                    <ValidationMessage For="@(() => Formulario.DocumentoComprador)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary small">Correo Electrónico (donde recibirás boletos) *</label>
                                    <input type="email" class="form-control bg-black text-white border-secondary" @bind="Formulario.CorreoComprador" placeholder="correo@ejemplo.com" />
                                    <ValidationMessage For="@(() => Formulario.CorreoComprador)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary small">Teléfono Móvil (WhatsApp)</label>
                                    <input type="tel" class="form-control bg-black text-white border-secondary" @bind="Formulario.TelefonoComprador" placeholder="Ej: +57 300 123 4567" />
                                    <ValidationMessage For="@(() => Formulario.TelefonoComprador)" />
                                </div>
                            </div>
                        </div>

                        <!-- Tarjetas de Asistentes Individuales -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="text-white fw-bold mb-0 font-monospace">ASISTENTES AL EVENTO (@Formulario.Cantidad)</h4>
                            <button class="btn btn-sm btn-outline-warning" @onclick="CopiarDatosCompradorAAsistente1">
                                <i class="bi bi-copy me-1"></i> Asignar comprador al Boleto 1
                            </button>
                        </div>

                        <p class="text-secondary small mb-3">
                            Cada boleto es nominal y genera un código QR criptográfico único vinculado al documento de cada asistente.
                        </p>

                        <ValidationMessage For="@(() => Formulario.Asistentes)" />
                        @for (int i = 0; i < Formulario.Asistentes.Count; i++)
                        {
                            var index = i;
                            var asistente = Formulario.Asistentes[index];

                            <div class="ugp-card p-3 mb-3 border-secondary border-opacity-50">
                                <div class="d-flex align-items-center gap-2 mb-2 text-warning fw-bold small font-monospace">
                                    <i class="bi bi-person-badge"></i> BOLETO #@(index + 1) - Localidad: @(TipoEntradaSeleccionado?.Nombre)
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <input type="text" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="Nombre completo *" @bind="asistente.NombreCompleto" />
                                        <ValidationMessage For="@(() => asistente.NombreCompleto)" />
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-group input-group-sm">
                                            <select class="form-select bg-black text-white border-secondary" style="max-width: 80px;" @bind="asistente.TipoDocumento">
                                                <option value="CC">CC</option>
                                                <option value="CE">CE</option>
                                                <option value="TI">TI</option>
                                                <option value="PAS">PAS</option>
                                                <option value="NIT">NIT</option>
                                            </select>
                                            <input type="text" class="form-control bg-black text-white border-secondary" placeholder="No. Documento *" @bind="asistente.DocumentoIdentidad" />
                                        </div>
                                        <ValidationMessage For="@(() => asistente.TipoDocumento)" />
                                        <ValidationMessage For="@(() => asistente.DocumentoIdentidad)" />
                                    </div>
                                    <div class="col-md-4">
                                        <input type="email" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="Correo electrónico *" @bind="asistente.CorreoElectronico" />
                                        <ValidationMessage For="@(() => asistente.CorreoElectronico)" />
                                    </div>
                                    <div class="col-md-4">
                                        <input type="tel" class="form-control form-control-sm bg-black text-white border-secondary"
                                               aria-label="Teléfono del asistente" placeholder="Teléfono (opcional)" @bind="asistente.Telefono" />
                                        <ValidationMessage For="@(() => asistente.Telefono)" />
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-4">
                            <button class="btn-ugp-outline" @onclick="() => PasoActual = 1">
                                <i class="bi bi-arrow-left me-1"></i> Volver a Localidades
                            </button>
                            <button class="btn-ugp-gold" @onclick="AvanzarPaso3">
                                <span>CONTINUAR AL PAGO</span>
                                <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Resumen Lateral -->
                    <div class="col-lg-4">
                        <div class="ugp-card p-4 border-warning border-opacity-25 sticky-top" style="top: 90px;">
                            <h5 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">ORDEN DE COMPRA</h5>
                            <div class="mb-2">
                                <span class="text-secondary small">Evento:</span>
                                <div class="text-white fw-bold">@EventoSeleccionado.Nombre</div>
                            </div>
                            <div class="mb-2">
                                <span class="text-secondary small">Localidad:</span>
                                <div class="text-warning">@(TipoEntradaSeleccionado?.Nombre)</div>
                            </div>
                            <div class="mb-2">
                                <span class="text-secondary small">Boletos:</span>
                                <div class="text-white">@Formulario.Cantidad unidades</div>
                            </div>
                            <div class="border-top border-secondary pt-3 mt-3">
                                <div class="d-flex justify-content-between fs-5 fw-bold text-white">
                                    <span>Total:</span>
                                    <span class="text-warning font-monospace">$@SubtotalCalculado.ToString("N0") COP</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- ==========================================================
                 PASO 3: RESUMEN FINAL Y PAGO CON WOMPI
                 ========================================================== -->
            @if (PasoActual == 3)
            {
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="ugp-card p-4 p-md-5 border-warning order-summary-card">
                            <div class="text-center mb-4">
                                <span class="ugp-badge-gold mb-2">PASO FINAL: PAGO SEGURO</span>
                                <h2 class="text-white fw-bold">CONFIRMACIÓN Y PASARELA WOMPI</h2>
                                <p class="text-secondary small">Verifica tu orden antes de proceder a la transacción bancaria cifrada.</p>
                            </div>

                            <div class="bg-black p-4 rounded-3 border border-secondary mb-4 order-summary-card">
                                <div class="row g-3">
                                    <div class="col-sm-6 summary-detail-item">
                                        <span class="text-secondary small">Evento:</span>
                                        <div class="text-white fw-bold">@EventoSeleccionado.Nombre</div>
                                    </div>
                                    <div class="col-sm-6 summary-detail-item">
                                        <span class="text-secondary small">Fecha y Hora:</span>
                                        <div class="text-white">@EventoSeleccionado.Fecha.ToString("dd/MM/yyyy") - @EventoSeleccionado.Hora.ToString("hh:mm tt")</div>
                                    </div>
                                    <div class="col-sm-6 summary-detail-item">
                                        <span class="text-secondary small">Lugar:</span>
                                        <div class="text-white">@EventoSeleccionado.Lugar</div>
                                    </div>
                                    <div class="col-sm-6 summary-detail-item">
                                        <span class="text-secondary small">Localidad:</span>
                                        <div class="text-warning fw-bold">@(TipoEntradaSeleccionado?.Nombre) (@Formulario.Cantidad boletos)</div>
                                    </div>
                                    <div class="col-sm-6 summary-detail-item">
                                        <span class="text-secondary small">Comprador:</span>
                                        <div class="text-white">@Formulario.NombreComprador (@Formulario.TipoDocumento: @Formulario.DocumentoComprador)</div>
                                    </div>
                                    <div class="col-sm-6 summary-detail-item">
                                        <span class="text-secondary small">Correo de Envío:</span>
                                        <div class="text-white">@Formulario.CorreoComprador</div>
                                    </div>
                                </div>

                                <div class="border-top border-secondary pt-3 mt-3 d-flex justify-content-between align-items-center">
                                    <span class="fs-5 text-white fw-bold">TOTAL A PAGAR:</span>
                                    <span class="fs-3 text-warning fw-bold font-monospace">$@SubtotalCalculado.ToString("N0") COP</span>
                                </div>
                            </div>

                            <button type="button" class="btn btn-ugp-gold w-100 py-3 mt-3 fw-bold" @onclick="RedirigirAWompiConPrecio" disabled="@CreandoOrden">
                                <i class="bi bi-credit-card me-2"></i> PAGAR CON WOMPI
                            </button>

                            <div class="text-center mt-3">
                                <button type="button" class="btn btn-link text-secondary text-decoration-none small" @onclick="() => PasoActual = 2" disabled="@(CreandoOrden || CompraWompiId is not null)">
                                    <i class="bi bi-arrow-left me-1"></i> Modificar Datos
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            </CascadingValue>
        }
    </div>
</div>

@code {
    [Parameter]
    public int? EventoId { get; set; }

    private bool Cargando = true;
    private int PasoActual = 1;
    private bool CreandoOrden;
    private int? CompraWompiId;
    private string MensajeError = "";

    private Evento? EventoSeleccionado;
    private List<TipoEntrada> TiposEntradaDisponibles = new();
    private TipoEntrada? TipoEntradaSeleccionado;

    private CheckoutFormVm Formulario = new();

    private decimal SubtotalCalculado => (TipoEntradaSeleccionado?.Precio ?? 0) * Formulario.Cantidad;

    private EditContext ContextoFormulario = null!;
    private ValidationMessageStore ErroresFormulario = null!;
    private int LimiteCantidad => Math.Min(CheckoutFormVm.MaximoBoletos,
        Math.Min(EventoSeleccionado?.TicketsDisponibles ?? 0, TipoEntradaSeleccionado?.Capacidad ?? 0));

    protected override void OnInitialized()
    {
        ContextoFormulario = new EditContext(Formulario);
        ErroresFormulario = new ValidationMessageStore(ContextoFormulario);
    }

    protected override async Task OnParametersSetAsync()
    {
        Cargando = true;
        MensajeError = "";
        PasoActual = 1;
        CompraWompiId = null;
        ErroresFormulario.Clear();
        EventoSeleccionado = null;
        TiposEntradaDisponibles.Clear();
        TipoEntradaSeleccionado = null;
        try
        {
            var eventos = Db.Eventos.AsNoTracking()
                .Include(e => e.EventoTiposEntrada).ThenInclude(ete => ete.TipoEntrada)
                .Include(e => e.Venue)
                .Where(e => e.EstadoEvento == "Activo" || e.EstadoEvento == "Próximo");

            EventoSeleccionado = EventoId.HasValue
                ? await eventos.FirstOrDefaultAsync(e => e.EventoId == EventoId.Value)
                : await eventos.OrderBy(e => e.Fecha).FirstOrDefaultAsync();

            if (EventoSeleccionado is not null)
            {
                TiposEntradaDisponibles = EventoSeleccionado.EventoTiposEntrada
                    .Select(ete => ete.TipoEntrada)
                    .Where(t => t.Precio > 0 && t.Capacidad > 0)
                    .ToList();
                if (TiposEntradaDisponibles.Count == 0 || EventoSeleccionado.TicketsDisponibles < 1)
                {
                    MensajeError = "No hay localidades disponibles para este evento.";
                }
            }

            Formulario.EventoId = EventoSeleccionado?.EventoId ?? 0;
            SeleccionarTipoEntrada(TiposEntradaDisponibles.FirstOrDefault()?.TipoEntradaId ?? 0);
            Formulario.Cantidad = 1;
            SincronizarListaAsistentes();
        }
        catch
        {
            EventoSeleccionado = null;
            MensajeError = "No se pudo cargar la boletería. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private void SeleccionarTipoEntrada(int tipoEntradaId)
    {
        Formulario.TipoEntradaId = tipoEntradaId;
        TipoEntradaSeleccionado = TiposEntradaDisponibles.FirstOrDefault(t => t.TipoEntradaId == tipoEntradaId);
    }

    private void IncrementarCantidad()
    {
        if (Formulario.Cantidad < LimiteCantidad)
        {
            Formulario.Cantidad++;
            SincronizarListaAsistentes();
        }
    }

    private void DisminuirCantidad()
    {
        if (Formulario.Cantidad > 1)
        {
            Formulario.Cantidad--;
            SincronizarListaAsistentes();
        }
    }

    private void SincronizarListaAsistentes()
    {
        while (Formulario.Asistentes.Count < Formulario.Cantidad)
        {
            Formulario.Asistentes.Add(new AsistenteInputVm());
        }
        while (Formulario.Asistentes.Count > Formulario.Cantidad)
        {
            Formulario.Asistentes.RemoveAt(Formulario.Asistentes.Count - 1);
        }
    }

    private void CopiarDatosCompradorAAsistente1()
    {
        if (Formulario.Asistentes.Any())
        {
            Formulario.Asistentes[0].NombreCompleto = Formulario.NombreComprador;
            Formulario.Asistentes[0].TipoDocumento = Formulario.TipoDocumento;
            Formulario.Asistentes[0].DocumentoIdentidad = Formulario.DocumentoComprador;
            Formulario.Asistentes[0].CorreoElectronico = Formulario.CorreoComprador;
            Formulario.Asistentes[0].Telefono = Formulario.TelefonoComprador;
        }
    }

    private void AvanzarPaso2()
    {
        MensajeError = "";
        ErroresFormulario.Clear();
        if (TipoEntradaSeleccionado is null)
        {
            ErroresFormulario.Add(ContextoFormulario.Field(nameof(Formulario.TipoEntradaId)), "Selecciona una localidad.");
        }
        else if (Formulario.Cantidad < 1 || Formulario.Cantidad > LimiteCantidad)
        {
            ErroresFormulario.Add(ContextoFormulario.Field(nameof(Formulario.Cantidad)),
                $"Selecciona entre 1 y {LimiteCantidad} boletos disponibles.");
        }
        else
        {
            PasoActual = 2;
        }

        ContextoFormulario.NotifyValidationStateChanged();
    }

    private bool ValidarFormulario()
    {
        Formulario.Normalizar();
        ErroresFormulario.Clear();
        var valido = true;
        foreach (var (modelo, error) in Formulario.Validar())
        {
            valido = false;
            foreach (var campo in error.MemberNames)
            {
                ErroresFormulario.Add(new FieldIdentifier(modelo, campo), error.ErrorMessage!);
            }
        }

        ContextoFormulario.NotifyValidationStateChanged();
        return valido;
    }

    private void AvanzarPaso3()
    {
        MensajeError = "";
        if (ValidarFormulario())
        {
            PasoActual = 3;
        }
    }

    private async Task RedirigirAWompiConPrecio()
    {
        if (CreandoOrden)
        {
            return;
        }

        CreandoOrden = true;
        MensajeError = "";
        try
        {
            var usuario = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            if (!AccesoCompra.HasBrowser(usuario))
            {
                MensajeError = "No se pudo iniciar la sesión de compra. Recarga la página y verifica que el navegador acepte cookies.";
                return;
            }

            if (CompraWompiId is null)
            {
                if (!ValidarFormulario())
                {
                    PasoActual = 2;
                    return;
                }

                var orden = await CompraService.CrearCompraPendienteAsync(Formulario);
                CompraWompiId = orden.CompraId;
            }

            var compraId = CompraWompiId.Value;
            await using var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/compra-access.js");
            await modulo.InvokeVoidAsync("activar", compraId, AccesoCompra.CreateHandoff(usuario, compraId));
            Navigation.NavigateTo($"pagos/wompi/{compraId}", forceLoad: true);
        }
        catch (ValidationException ex)
        {
            var campos = ex.ValidationResult?.MemberNames ?? [];
            foreach (var campo in campos)
            {
                ErroresFormulario.Add(ContextoFormulario.Field(campo), ex.Message);
            }

            if (campos.Any())
            {
                PasoActual = 1;
                ContextoFormulario.NotifyValidationStateChanged();
            }
            else
            {
                MensajeError = ex.Message;
            }
        }
        catch
        {
            MensajeError = "No se pudo continuar con la orden. Intenta nuevamente.";
        }
        finally
        {
            CreandoOrden = false;
        }
    }
}
