@page "/"
@rendermode InteractiveServer
@inject ApplicationDbContext Db
@inject ITicketService TicketService
@inject ILogger<Home> Logger

<PageTitle>UGP - Ultimate Grappling Promotion | MMA & Combat Sports</PageTitle>

<section class="site-hero" aria-labelledby="site-hero-title">
    <picture>
        <source media="(max-width: 767px)" srcset="images/ugp/portada-movil.jpg" />
        <img class="site-hero-image" src="images/ugp/portada-escritorio.jpg" alt="" fetchpriority="high" />
    </picture>

    <div class="container site-hero-content">
        <p class="hero-brand">Último Guerrero en Pie</p>
        <h1 id="site-hero-title"><span>Próximos</span> eventos</h1>
        <p class="hero-intro">Artes marciales mixtas en Colombia</p>

        @if (CargandoEventos)
        {
            <p class="hero-message" role="status">Cargando eventos…</p>
        }
        else if (Destacados.Count == 0)
        {
            <p class="hero-message" role="status">@(ErrorEventos
                ? "No pudimos cargar los eventos. Intenta nuevamente más tarde."
                : "Por ahora no hay eventos con entradas disponibles.")</p>
        }
        else
        {
            <div role="region" aria-roledescription="carrusel" aria-label="Eventos con entradas disponibles">
                <div id="portada-eventos" class="hero-cards">
                    @for (var i = 0; i < Math.Min(Destacados.Count, 3); i++)
                    {
                        var destacado = Destacados[(Diapositiva + i) % Destacados.Count];
                        var evento = destacado.Evento;
                        <article @key="evento.EventoId" class="hero-card @(i == 0 ? "hero-card-active" : "hero-card-preview")">
                            <span class="hero-badge">@evento.EstadoEvento</span>
                            <h2><a class="text-reset" href="@($"/eventos/{evento.EventoId}")">@evento.Nombre</a></h2>
                            <p><i class="bi bi-calendar3" aria-hidden="true"></i> @evento.Fecha.ToString("dd MMM yyyy") · @evento.Hora.ToString("hh:mm tt")</p>
                            <p><i class="bi bi-geo-alt" aria-hidden="true"></i> @evento.Lugar</p>
                            <p>Desde @destacado.PrecioDesde!.Value.ToString("C", CulturaCop) COP</p>
                            <a class="hero-purchase" href="@($"/checkout/{evento.EventoId}")" aria-label="@($"Comprar entradas para {evento.Nombre}")">Comprar entradas</a>
                        </article>
                    }
                </div>

                @if (Destacados.Count > 1)
                {
                    <div class="hero-controls" role="group" aria-label="Controles del carrusel">
                        <button type="button" aria-label="Evento anterior" aria-controls="portada-eventos" @onclick="Anterior">‹</button>
                        @for (var i = 0; i < Destacados.Count; i++)
                        {
                            var indice = i;
                            <button type="button" class="hero-dot" aria-label="@($"Mostrar evento {indice + 1}: {Destacados[indice].Evento.Nombre}")"
                                    aria-pressed="@(indice == Diapositiva ? "true" : "false")" aria-controls="portada-eventos"
                                    @onclick="() => Diapositiva = indice"><span></span></button>
                        }
                        <button type="button" aria-label="Evento siguiente" aria-controls="portada-eventos" @onclick="Siguiente">›</button>
                    </div>
                    <span class="visually-hidden" role="status">Evento @(Diapositiva + 1) de @Destacados.Count: @Destacados[Diapositiva].Evento.Nombre</span>
                }
            </div>
        }

        <a class="hero-calendar" href="#eventos">Ver cartelera</a>
    </div>
</section>

<div class="container">
    <div class="ugp-stats-strip home-stats">
        <div class="ugp-stat-item">
            <div class="num">@(CargandoEventos || ErrorEventos ? "—" : EventosList.Count.ToString())</div>
            <div class="lbl">Eventos próximos</div>
        </div>
        <div class="ugp-stat-item">
            <div class="num">@(CargandoPeleadores || ErrorPeleadores ? "—" : TotalPeleadores.ToString())</div>
            <div class="lbl">Peleadores registrados</div>
        </div>
    </div>
</div>

<!-- ======================================================================
     SECCIÓN 2: CARTELERA DE PRÓXIMOS EVENTOS
     ====================================================================== -->
<section id="eventos" class="py-5" style="background: var(--ugp-dark-1); border-bottom: 1px solid var(--border-subtle);">
    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5">
            <div>
                <span class="ugp-badge-gold mb-2">CALENDARIO OFICIAL</span>
                <h2 class="display-6 fw-bold text-white mb-0">PRÓXIMOS EVENTOS</h2>
            </div>
            <p class="text-secondary small mt-3 mt-md-0 mb-0" style="max-width: 420px;">
                Asegura tu lugar en la arena. Todos los boletos incluyen asignación de zona y credencial digital verificable con código QR.
            </p>
        </div>

        <div class="row g-4">
            @if (CargandoEventos)
            {
                <p role="status">Cargando cartelera…</p>
            }
            else if (EventosList.Any())
            {
                @foreach (var entrada in EventosList)
                {
                    var ev = entrada.Evento;
                    <div class="col-lg-4 col-md-6">
                        <div class="event-card">
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(ev.ImagenUrl) ? "images/ugp/portada-escritorio.jpg" : ev.ImagenUrl)"
                                     alt="@ev.Nombre" 
                                     class="event-card-img" />
                                <span class="position-absolute top-0 end-0 m-3 badge bg-black border border-warning text-warning px-3 py-2 text-uppercase font-monospace">
                                    @(ev.EstadoEvento ?? "Sin estado")
                                </span>
                            </div>
                            <div class="event-card-body">
                                <div>
                                    <div class="text-warning small fw-bold font-monospace mb-1">
                                        <i class="bi bi-calendar3 me-1"></i> @ev.Fecha.ToString("dd MMMM, yyyy") • @ev.Hora.ToString("hh:mm tt")
                                    </div>
                                    <h4 class="text-white fw-bold mb-2"><a class="text-reset" href="@($"/eventos/{ev.EventoId}")">@ev.Nombre</a></h4>
                                    <div class="text-secondary small mb-3">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @ev.Lugar
                                    </div>
                                    <p class="text-secondary small line-clamp-2">
                                        @(string.IsNullOrEmpty(ev.Descripcion) ? "Descripción no disponible." : ev.Descripcion)
                                    </p>
                                </div>
                                <div class="pt-3 border-top border-secondary d-flex justify-content-between align-items-center mt-3">
                                    @if (entrada.PrecioDesde is decimal precio)
                                    {
                                        <div>
                                            <div class="text-secondary small">DESDE</div>
                                            <div class="text-white fw-bold">@precio.ToString("C", CulturaCop) COP</div>
                                        </div>
                                        <a href="@($"/checkout/{ev.EventoId}")" class="btn-ugp-gold btn-sm px-3 py-2">
                                            <i class="bi bi-ticket-fill" aria-hidden="true"></i> COMPRAR ENTRADAS
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-light">Entradas no disponibles</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-calendar-x fs-1 text-secondary mb-3"></i>
                    <p class="text-secondary">@(ErrorEventos ? "No pudimos cargar la cartelera. Intenta nuevamente más tarde." : "No hay próximos eventos publicados en este momento.")</p>
                </div>
            }
        </div>
    </div>
</section>

@if (EventosActivosIniciados.Count > 0)
{
    <section id="eventos-en-curso" class="container py-4" aria-labelledby="en-curso-title">
        <h2 id="en-curso-title">Eventos activos iniciados</h2>
        <p class="text-secondary">Su inicio ya pasó y siguen marcados como activos. No se dispone de una hora de finalización; consulta el detalle.</p>
        <div class="row g-4">
            @foreach (var evento in EventosActivosIniciados)
            {
                <article class="col-md-6 col-lg-4">
                    <a href="@($"/eventos/{evento.EventoId}")">@evento.Nombre</a>
                    <p>@evento.Fecha.ToString("dd/MM/yyyy") · @evento.Hora.ToString("HH:mm") (Colombia)</p>
                </article>
            }
        </div>
    </section>
}
<!-- ======================================================================
     SECCIÓN 3: ROSTER DE COMBATE (PELEADORES)
     ====================================================================== -->
<section id="peleadores" class="py-5" style="background: var(--ugp-black); border-bottom: 1px solid var(--border-subtle);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="ugp-badge-red mb-2"><i class="bi bi-fire me-1"></i> ROSTER DE GUERREROS</span>
            <h2 class="display-6 fw-bold text-white mb-2">ATLETAS DESTACADOS</h2>
            <p class="text-secondary mx-auto small" style="max-width: 550px;">
                Conoce a los peleadores registrados en UGP.
            </p>
        </div>

        <div class="row g-4">
            @if (CargandoPeleadores || ErrorPeleadores || PeleadoresList.Count == 0)
            {
                <p class="col-12 text-secondary" role="status">@(CargandoPeleadores ? "Cargando peleadores…" : ErrorPeleadores ? "No pudimos cargar los peleadores. Intenta más tarde." : "No hay peleadores publicados por ahora.")</p>
            }
            @foreach (var peleador in PeleadoresList)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="fighter-card">
                        <div class="fighter-image-wrap">
                            @if (!string.IsNullOrWhiteSpace(peleador.FotoUrl))
                            {
                                <img src="@peleador.FotoUrl" alt="@peleador.Nombre" />
                            }
                            else { <span class="text-secondary p-3">Fotografía no disponible</span> }
                            <div class="fighter-overlay"></div>
                            <span class="position-absolute top-0 start-0 m-3 badge bg-black bg-opacity-75 border border-secondary text-white small">
                                @(peleador.Peso.HasValue ? $"{peleador.Peso:N0} KG" : "Peso no registrado")
                            </span>
                        </div>
                        <div class="fighter-body">
                            <div class="fighter-nickname">"@(!string.IsNullOrEmpty(peleador.Apodo) ? peleador.Apodo : "Sin apodo registrado")"</div>
                            <h4 class="fighter-name">@peleador.Nombre</h4>
                            <div class="fighter-stats-row">
                                <span><i class="bi bi-flag-fill me-1 text-warning"></i> @(peleador.Nacionalidad ?? "Nacionalidad no registrada")</span>
                                <div class="fighter-record">@(peleador.PeleasGanadas?.ToString() ?? "—")W - @(peleador.PeleasPerdidas?.ToString() ?? "—")L</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ======================================================================
     SECCIÓN 4: CONTROL DE ACCESOS Y VALIDACIÓN RÁPIDA DE BOLETOS
     ====================================================================== -->
<section id="validar-boleto" class="py-5" style="background: radial-gradient(circle at 50% 50%, rgba(212,175,55,0.06) 0%, rgba(13,13,13,0.95) 100%); border-bottom: 1px solid var(--border-subtle);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="ugp-card p-4 p-md-5 border-warning border-opacity-25">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="p-3 bg-black border border-warning rounded-circle text-warning fs-3">
                            <i class="bi bi-qr-code-scan"></i>
                        </div>
                        <div>
                            <span class="ugp-badge-gold">SEGURIDAD CRIPTOGRÁFICA</span>
                            <h3 class="text-white fw-bold mb-0">VERIFICACIÓN DE AUTENTICIDAD DEL BOLETO</h3>
                        </div>
                    </div>

                    <p class="text-secondary small mb-4">
                        Ingresa el contenido completo del QR para comprobar su autenticidad. La consulta no registra el ingreso.
                    </p>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-9">
                            <input type="text" 
                                   class="form-control bg-black text-white border-secondary py-2 font-monospace" 
                                   placeholder="Contenido completo del QR"
                                   maxlength="128"
                                   @bind="codigoParaValidar" 
                                   @bind:event="oninput" />
                        </div>
                        <div class="col-sm-3">
                            <button class="btn-ugp-gold w-100 py-2" @onclick="EjecutarValidacion" disabled="@ValidandoBoleto">
                                <i class="bi bi-search"></i> VERIFICAR
                            </button>
                        </div>
                    </div>

                    @if (mensajeValidacionQr is not null)
                    {
                        <p class="mt-3 text-white" role="status">@mensajeValidacionQr</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================================
     SECCIÓN 5: EXPERIENCIAS & TESTIMONIOS DE FANÁTICOS
     ====================================================================== -->
<UGP_ultimo_guerrero_en_pie_.Components.Multimedia.MultimediaGallery />

<section id="experiencias" class="py-5" style="background: var(--ugp-dark-1); border-bottom: 1px solid var(--border-subtle);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="ugp-badge-gold mb-2">FAN ZONE</span>
            <h2 class="display-6 fw-bold text-white mb-2">EXPERIENCIA UGP</h2>
            <p class="text-secondary mx-auto small" style="max-width: 550px;">
                Experiencias compartidas en UGP.
            </p>
        </div>

        <div class="row g-4">
            @if (CargandoExperiencias || ErrorExperiencias || ExperienciasList.Count == 0)
            {
                <p class="col-12 text-secondary" role="status">@(CargandoExperiencias ? "Cargando experiencias…" : ErrorExperiencias ? "No pudimos cargar las experiencias. Intenta más tarde." : "No hay experiencias publicadas por ahora.")</p>
            }
            @foreach (var exp in ExperienciasList)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="review-card">
                        <div class="review-stars">
                            @for (int i = 0; i < (exp.Calificacion is >= 1 and <= 5 ? exp.Calificacion.Value : 0); i++)
                            {
                                <i class="bi bi-star-fill text-warning me-1"></i>
                            }
                        </div>
                        <h5 class="text-white fw-bold mb-2">@exp.Nombre</h5>
                        <p class="text-secondary small mb-3" style="line-height: 1.6;">
                            "@(string.IsNullOrEmpty(exp.Descripcion) ? "Sin descripción." : exp.Descripcion)"
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary small text-muted">
                            <span>Experiencia publicada</span>
                            <span></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ======================================================================
     SECCIÓN 6: MURO DE PATROCINADORES OFICIALES
     ====================================================================== -->
<section id="patrocinadores" class="py-5" style="background: var(--ugp-black);">
    <div class="container py-4 text-center">
        <span class="text-secondary font-monospace small text-uppercase letter-spacing-2">ALIANZAS ESTRATÉGICAS</span>
        <h3 class="fw-bold text-white mb-4 mt-1" style="font-family: var(--font-heading); letter-spacing: 2px;">
            PATROCINADORES OFICIALES
        </h3>

        <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 py-3">
            @if (CargandoPatrocinadores || ErrorPatrocinadores || PatrocinadoresList.Count == 0)
            {
                <p class="text-secondary" role="status">@(CargandoPatrocinadores ? "Cargando patrocinadores…" : ErrorPatrocinadores ? "No pudimos cargar los patrocinadores. Intenta más tarde." : "No hay patrocinadores publicados por ahora.")</p>
            }
            @foreach (var pat in PatrocinadoresList)
            {
                <div class="sponsor-logo-item bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 p-3">
                    <span class="text-secondary fw-bold font-monospace fs-5">
                        <i class="bi bi-award-fill text-warning me-1"></i> @pat.Empresa
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private static readonly System.Globalization.CultureInfo CulturaCop = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
    private sealed record EventoCartelera(Evento Evento, decimal? PrecioDesde);
    private List<EventoCartelera> EventosList = [];
    private List<EventoCartelera> Destacados = [];
    private bool ErrorEventos, ErrorPeleadores, ErrorPatrocinadores, ErrorExperiencias;
    private bool CargandoEventos = true, CargandoPeleadores = true, CargandoPatrocinadores = true, CargandoExperiencias = true;
    private List<Evento> EventosActivosIniciados = [];
    private int Diapositiva;

    private void Anterior() => Diapositiva = (Diapositiva + Destacados.Count - 1) % Destacados.Count;
    private void Siguiente() => Diapositiva = (Diapositiva + 1) % Destacados.Count;
    private List<Peleador> PeleadoresList = new();
    private List<Patrocinador> PatrocinadoresList = new();
    private List<Experiencia> ExperienciasList = new();

    private int TotalPeleadores = 0;

    private string codigoParaValidar = "";
    private string? mensajeValidacionQr;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ahora = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTimeOffset.UtcNow, "SA Pacific Standard Time").DateTime;
            var localidades = VentaEventoPublica.LocalidadesDisponibles(Db);
            var eventos = await Db.Eventos.AsNoTracking()
                .OrderBy(e => e.Fecha)
                .ThenBy(e => e.Hora)
                .ThenBy(e => e.EventoId)
                .Select(e => new
                {
                    Evento = e,
                    Precio = localidades.Where(l => l.EventoId == e.EventoId)
                        .OrderBy(l => l.Precio)
                        .Select(l => (decimal?)l.Precio)
                        .FirstOrDefault()
                })
                .ToListAsync();

            EventosList = eventos.Where(e => e.Evento.Fecha.ToDateTime(e.Evento.Hora) > ahora).Select(e => new EventoCartelera(e.Evento,
                VentaEventoPublica.Habilitada(e.Evento)
                    ? e.Precio : null)).ToList();
            Destacados = EventosList.Where(e => e.PrecioDesde.HasValue).Take(4).ToList();
            EventosActivosIniciados = eventos.Where(e => e.Evento.EstadoEvento == "Activo" && e.Evento.Fecha.ToDateTime(e.Evento.Hora) <= ahora).Select(e => e.Evento).ToList();
        }
        catch (Exception ex)
        {
            ErrorEventos = true;
            Logger.LogError("Home: error en eventos ({Tipo}).", ex.GetType().Name);
        }
        finally { CargandoEventos = false; }

        try
        {
            PeleadoresList = await Db.Peleadores.AsNoTracking()
                .OrderByDescending(p => p.PeleasGanadas)
                .Take(8)
                .ToListAsync();

            TotalPeleadores = await Db.Peleadores.CountAsync();

        }
        catch (Exception ex)
        {
            ErrorPeleadores = true;
            PeleadoresList.Clear();
            Logger.LogError("Home: error en peleadores ({Tipo}).", ex.GetType().Name);
        }
        finally { CargandoPeleadores = false; }
        try { PatrocinadoresList = await Db.Patrocinadores.AsNoTracking().ToListAsync(); }
        catch (Exception ex) { ErrorPatrocinadores = true; Logger.LogError("Home: error en patrocinadores ({Tipo}).", ex.GetType().Name); }
        finally { CargandoPatrocinadores = false; }
        try { ExperienciasList = await Db.Experiencias.AsNoTracking().Take(6).ToListAsync(); }
        catch (Exception ex) { ErrorExperiencias = true; Logger.LogError("Home: error en experiencias ({Tipo}).", ex.GetType().Name); }
        finally { CargandoExperiencias = false; }
    }

    private bool ValidandoBoleto;

    private async Task EjecutarValidacion()
    {
        if (ValidandoBoleto) return;

        ValidandoBoleto = true;
        mensajeValidacionQr = null;
        try
        {
            mensajeValidacionQr = await TicketService.EsQrAutenticoAsync(codigoParaValidar.Trim())
                ? "El código QR es auténtico. Esta consulta no autoriza el ingreso."
                : "No se pudo verificar el código QR.";
        }
        catch
        {
            mensajeValidacionQr = "No se pudo verificar el código QR.";
        }
        finally
        {
            ValidandoBoleto = false;
        }
    }
}
